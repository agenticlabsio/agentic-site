{
  "name": "agenticdemo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "npx opennextjs-cloudflare build",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npx opennextjs-cloudflare build && npx wrangler deploy",
    "cf:deploy:prod": "npx opennextjs-cloudflare build && npx wrangler deploy --env production"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  },
  "dependencies": {
    "geist": "^1.7.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.74.0"
  }
}
