{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/app/**/*.{ts,tsx}", "src/payload.config.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/payload-types.ts",
    "src/migrations/**",
    "src/seed/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "ignoreDependencies": [
    "@cloudflare/workers-types",
    "@types/node",
    "@types/react",
    "@types/react-dom",
    "cross-env",
    "prettier-plugin-tailwindcss"
  ],
  "workspaces": {
    ".": {
      "entry": ["src/app/**/*.{ts,tsx}", "src/payload.config.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/demo": {
      "entry": ["app/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    }
  }
}
